{
  "name": "grammar-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Grammar HUB - Integrated English learning platform",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync-curriculum": "node scripts/sync-curriculum.mjs",
